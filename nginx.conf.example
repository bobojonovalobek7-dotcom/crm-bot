# =======================================================
# EduCenter CRM & Telegram Bot Nginx Reverse Proxy Config
# Faylni joylash: /etc/nginx/sites-available/educenter.conf
# Faollashtirish: sudo ln -s /etc/nginx/sites-available/educenter.conf /etc/nginx/sites-enabled/
# =======================================================

server {
    listen 80;
    server_name crm.sizning-domeningiz.uz;

    # Katta fayllar (masalan, cheklar yoki materiallar) uchun hajm
    client_max_body_size 50M;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;

        # WebSocket va HTTP sarlavhalari
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 300s;
        proxy_connect_timeout 75s;
    }
}

# SSL (HTTPS) o'rnatish uchun komanda:
# sudo certbot --nginx -d crm.sizning-domeningiz.uz
